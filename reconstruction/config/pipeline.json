{
  "project": "nammaspace",
  "preprocess": {
    "fps": 10,
    "qscale": 2,
    "dedupe": true,
    "blur_drop_percentile": 3,
    "max_width": 1920
  },
  "colmap": {
    "matcher": "sequential",
    "camera_model": "OPENCV",
    "single_camera": true,
    "use_gpu": false
  },
  "train": {
    "backend": "brush",
    "method": "splatfacto",
    "max_iterations": 15000,
    "growth_stop_iter": 5000,
    "growth_grad_threshold": 0.00004,
    "refine_every": 100
  },
  "_tools_help": "Override tool paths per-machine via env vars (FFMPEG_BIN, COLMAP_BIN, BRUSH_BIN) or the 'tools' block below. Leave empty to use PATH. Do not commit machine-specific absolute paths.",
  "tools": {
    "ffmpeg": "C:/tools/ffmpeg_extracted/ffmpeg-9.0.2-full_build/bin/ffmpeg.exe",
    "colmap": "C:/tools/colmap_extracted/bin/colmap.exe",
    "brush_app": "C:/tools/brush_extracted/brush_app.exe"
  },
  "scene": {
    "id": "scene-001",
    "name": "NammaSpace Scene 001",
    "up_axis": "auto",
    "eye_height": 1.6,
    "walk_speed": 3.2,
    "sprint_multiplier": 2.2,
    "bounds_percentile": [
      2,
      98
    ]
  }
}